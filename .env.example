# ---- Server ----
NODE_ENV=development
PORT=3000
# Exact origin of the React app (scheme + host + port, no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173
APP_NAME=Podcast Clipper
# Number of reverse-proxy hops in front of the API (0 = none). Needed for correct rate limiting behind a proxy.
TRUST_PROXY=0

# ---- PostgreSQL ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/podcast_clipper
DATABASE_SSL=false
DB_POOL_MAX=10

# ---- Secrets (each at least 32 characters, and different from each other) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CODE_HMAC_SECRET=

# ---- Session cookie ----
# One value controls both JWT expiry and cookie lifetime
SESSION_HOURS=24
# false for http://localhost development. MUST be true in production (HTTPS); the app refuses to start otherwise.
COOKIE_SECURE=false
# lax works when frontend and API are same-site (localhost:5173 -> localhost:3000, or app.example.com -> api.example.com)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# ---- Passwords & verification codes ----
BCRYPT_ROUNDS=12
VERIFICATION_EXPIRY_SECONDS=600
VERIFICATION_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60

# ---- Email (Gmail: use an App Password, not your normal password) ----
EMAIL_MODE=smtp
EMAIL_USER=
EMAIL_PASS=

# ---- Rate limits (per IP, per window) ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_VERIFY_MAX=10
RATE_LIMIT_LOGIN_MAX=10

# ---- Cloud storage (Cloudflare R2, S3-compatible) ----
CLOUD_ACCOUNT_ID=
BUCKET_NAME=
# Public base URL of the bucket (r2.dev URL or your custom domain), no trailing slash
CLOUD_PUBLIC_URI=
# R2 S3-API credentials (R2 > Manage API tokens > S3 Auth). TOKEN_VALUE (the cfat_ token) is NOT used by this code.
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
# Optional: override the S3 endpoint (default https://<CLOUD_ACCOUNT_ID>.r2.cloudflarestorage.com)
# CLOUD_ENDPOINT=

# ---- Uploads ----
UPLOAD_PART_SIZE_MB=16
UPLOAD_MAX_BYTES=10737418240
UPLOAD_MAX_ACTIVE_PER_USER=3
UPLOAD_URL_TTL_SECONDS=900
UPLOAD_SESSION_TTL_HOURS=48
UPLOAD_COMPLETE_STALE_SECONDS=120
RATE_LIMIT_UPLOAD_MAX=2000
