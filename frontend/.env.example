# Base URL of the backend API (no trailing slash).
# Use the SAME hostname style as the page you open: if you browse http://localhost:5173, use localhost here too
# (mixing localhost and 127.0.0.1 makes the browser treat them as different sites and the cookie is not sent).
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_NAME=Podcast Clipper
